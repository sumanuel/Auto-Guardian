{
  "expo": {
    "name": "Auto-Guardian",
    "slug": "Auto-Guardian",
    "version": "0.1.1.260728",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "autoguardian",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#0F5FD2",
        "foregroundImage": "./assets/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.trenkit.autoguardian",
      "queries": {
        "schemes": ["tel", "sms", "mailto", "whatsapp"],
        "intents": [
          {
            "action": "android.intent.action.VIEW",
            "data": {
              "scheme": "https",
              "host": "api.whatsapp.com"
            }
          }
        ]
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0F5FD2",
          "dark": {
            "backgroundColor": "#0F5FD2"
          }
        }
      ],
      "expo-web-browser",
      "expo-localization",
      "expo-notifications",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Auto Guardian usa Face ID para proteger tus vehículos y documentos."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "1cfe475d-fd7b-4af5-aa6f-d30cad92a24d"
      },
      "storeUpdate": {
        "androidPackage": "com.trenkit.autoguardian",
        "versionCheckUrl": "https://raw.githubusercontent.com/sumanuel/autoguardian-update/main/version.json",
        "timeoutMs": 7000,
        "allowDevChecks": true
      }
    }
  }
}
